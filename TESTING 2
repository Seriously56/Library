    self:create("Frame", {
        Parent = sidebar,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.fromScale(1, 0),
        Size = UDim2.new(0, 1, 1, 0),
        BackgroundColor3 = palette.divider,
        BorderSizePixel = 0,
        ZIndex = 3,
    })

    local brandHeader = self:create("Frame", {

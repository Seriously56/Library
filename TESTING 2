        library:apply_theme(button, "accent", "TextColor3")

        library:connection(button.MouseEnter, function()
            library:tween(button, {BackgroundTransparency = 0, BackgroundColor3 = palette.controlHover}, Enum.EasingStyle.Quad, 0.1)
        end)
        library:connection(button.MouseLeave, function()
            library:tween(button, {BackgroundTransparency = 1}, Enum.EasingStyle.Quad, 0.1)
        end)
        return button
    end

    function cfg.changetext(text)
        cfg.name = tostring(text or "")
        cfg.items.name.Text = cfg.name
    end

    function cfg.set_visible(visible)
        visible = visible == true
        cfg.open = visible
        local holder = cfg.items.dropdown_holder
        local field = cfg.items.dropdown

        if visible then
            library:close_element(cfg)
            local absolute = field.AbsolutePosition
            local viewport = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
            local popupWidth = math.max(1, math.min(cfg.width, viewport.X - 16))
            local popupHeight = math.max(1, math.min(cfg.y_size + 8, 190, viewport.Y - 16))
            local x, y = clampPopupPosition(absolute.X, absolute.Y + field.AbsoluteSize.Y + 5, popupWidth, popupHeight)
            holder.Position = offset(x, y)
            holder.Visible = true
            holder.Size = offset(popupWidth, 0)
            cfg.items.indicator.Rotation = 180
            library:tween(holder, {Size = offset(popupWidth, popupHeight)}, Enum.EasingStyle.Quad, 0.15)
        else
            cfg.items.indicator.Rotation = 0
            library:tween(holder, {Size = offset(holder.Size.X.Offset, 0)}, Enum.EasingStyle.Quad, 0.12)
            task.delay(0.13, function()
                if not cfg.open and holder.Parent then
                    holder.Visible = false
                end
            end)
            if library.current_open == cfg then
                library.current_open = nil
            end
        end
    end

    function cfg.set(value)
        local selected = {}
        local isTable = type(value) == "table"

        for _, option in ipairs(cfg.option_instances) do
            local chosen = option.Text == tostring(value) or (isTable and table.find(value, option.Text) ~= nil)
            option.TextColor3 = chosen and themes.preset.accent or palette.textMuted
            if chosen then
                table.insert(selected, option.Text)
            end
        end

        if cfg.multi then
            cfg.multi_items = selected
            flags[cfg.flag] = selected
            cfg.items.sub_text.Text = table.concat(selected, ", ")
        else
            flags[cfg.flag] = selected[1]
            cfg.items.sub_text.Text = selected[1] or ""
        end
        safeCall(cfg.callback, flags[cfg.flag])
    end

    function cfg.refresh_options(list)
        for _, option in ipairs(cfg.option_instances) do
            option:Destroy()
        end
        table.clear(cfg.option_instances)
        cfg.y_size = 0
        cfg.options = list or {}

        for _, optionValue in ipairs(cfg.options) do
            local button = cfg.render_option(optionValue)
            table.insert(cfg.option_instances, button)
            cfg.y_size = cfg.y_size + 27

            library:connection(button.InputBegan, function(input)
                if not isPrimaryInput(input) then
                    return
                end

                if cfg.multi then
                    local selected = table.clone(cfg.multi_items)
                    local index = table.find(selected, button.Text)
                    if index then
                        table.remove(selected, index)
                    else
                        table.insert(selected, button.Text)
                    end
                    cfg.set(selected)
                else
                    cfg.set(button.Text)
                    cfg.set_visible(false)
                end
            end)
        end
    end

    library:connection(cfg.items.dropdown.InputBegan, function(input)
        if isPrimaryInput(input) then
            cfg.set_visible(not cfg.open)
        end
    end)

    if cfg.seperator then
        addElementDivider(self)
    end
    cfg.refresh_options(cfg.options)
    flags[cfg.flag] = cfg.multi and {} or nil
    cfg.set(cfg.default)
    config_flags[cfg.flag] = cfg.set
    return setmetatable(cfg, library)
end


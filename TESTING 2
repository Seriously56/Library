    if self.items or self.other then
        self:unload_menu()
        self.unloaded = false
    end

    local screenGui = self:create("ScreenGui", {
        Name = "RXGraphiteUI",
        Enabled = true,
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder = properties.DisplayOrder or 90,
    })
    resolveGuiParent(screenGui)
    self.items = screenGui

    local popupGui = self:create("ScreenGui", {
        Name = "RXGraphitePopups",
        Enabled = true,
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder = (properties.DisplayOrder or 90) + 1,
    })
    resolveGuiParent(popupGui)
    self.other = popupGui

    local viewport = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
    local requestedWidth = cfg.size.X.Offset
    local requestedHeight = cfg.size.Y.Offset
    local viewportScale = math.min(
        1,
        math.max(0.1, (viewport.X - 16) / math.max(requestedWidth, 1)),
        math.max(0.1, (viewport.Y - 16) / math.max(requestedHeight, 1))
    )

    local shadow = self:create("Frame", {
        Parent = screenGui,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 6, 0.5, 8),
        Size = cfg.size,
        BackgroundColor3 = rgb(0, 0, 0),
        BackgroundTransparency = 0.45,
        BorderSizePixel = 0,
        ZIndex = 0,
    })
    makeCorner(shadow, 11)
    local shadowScale = self:create("UIScale", {
        Parent = shadow,
        Scale = viewportScale,
    })

    local main = self:create("Frame", {
        Parent = screenGui,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = cfg.size,
        BackgroundColor3 = palette.graphite,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        Active = true,
        ZIndex = 1,
    })
    cfg.items.main = main
    makeCorner(main, 10)
    makeStroke(main, palette.border, 0, 1)
    local mainScale = self:create("UIScale", {
        Parent = main,
        Scale = viewportScale,
    })

    self:connection(main:GetPropertyChangedSignal("Position"), function()
        shadow.Position = UDim2.new(main.Position.X.Scale, main.Position.X.Offset + 6, main.Position.Y.Scale, main.Position.Y.Offset + 8)
    end)
    self:connection(main:GetPropertyChangedSignal("Size"), function()
        shadow.Size = main.Size
    end)

    if Camera then
        self:connection(Camera:GetPropertyChangedSignal("ViewportSize"), function()
            local newViewport = Camera.ViewportSize
            local newScale = math.min(
                1,
                math.max(0.1, (newViewport.X - 16) / math.max(main.Size.X.Offset, 1)),
                math.max(0.1, (newViewport.Y - 16) / math.max(main.Size.Y.Offset, 1))
            )
            mainScale.Scale = newScale
            shadowScale.Scale = newScale
        end)
    end

    local sidebar = self:create("Frame", {
        Parent = main,
        Size = UDim2.new(0, 196, 1, -26),
        BackgroundColor3 = palette.sidebar,
        BorderSizePixel = 0,
        ZIndex = 2,

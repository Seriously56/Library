local function resolveElementParent(object)
    return object and object.items and object.items.elements
end

local function addElementDivider(object)
    local parent = resolveElementParent(object)
    if not parent then
        return nil
    end

    return library:create("Frame", {
        Parent = parent,
        Size = UDim2.new(1, 0, 0, 1),
        BackgroundColor3 = palette.divider,
        BorderSizePixel = 0,
        ZIndex = 6,
    })
end

local function createElementRow(object, options, height)
    options = options or {}
    local parent = resolveElementParent(object)
    assert(parent, "This control must be parented to a section, settings panel, or compatible container")

    local row = makeButton({
        Parent = parent,
        Size = UDim2.new(1, 0, 0, height or 24),
        BackgroundTransparency = 1,
        ZIndex = 6,
    })

    local infoText = options.info
    local label = makeLabel({
        Parent = row,
        Position = offset(4, 0),
        Size = UDim2.new(1, -8, 0, infoText and 18 or (height or 24)),
        Text = tostring(options.name or "Control"),
        Font = Enum.Font.Gotham,
        TextSize = 13,
        TextColor3 = palette.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Center,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 7,
    })

    local info
    if infoText then
        info = makeLabel({
            Parent = row,
            Position = offset(4, 18),
            Size = UDim2.new(1, -8, 0, math.max(16, (height or 42) - 18)),
            Text = tostring(infoText),
            Font = Enum.Font.Gotham,
            TextSize = 11,
            TextColor3 = palette.textMuted,
            TextXAlignment = Enum.TextXAlignment.Left,
            TextYAlignment = Enum.TextYAlignment.Top,
            TextWrapped = true,
            ZIndex = 7,
        })
    end

    local rightComponents = library:create("Frame", {
        Parent = row,
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, -4, 0, 0),
        Size = UDim2.new(0, 0, 0, infoText and 18 or (height or 24)),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundTransparency = 1,
        ZIndex = 8,
    })
    library:create("UIListLayout", {
        Parent = rightComponents,
        FillDirection = Enum.FillDirection.Horizontal,
        HorizontalAlignment = Enum.HorizontalAlignment.Right,
        VerticalAlignment = Enum.VerticalAlignment.Center,
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, 7),
    })

    return row, label, info, rightComponents
end

function library:toggle(options)
    options = options or {}
    local cfg = {
        enabled = options.default == true,
        name = options.name or "Toggle",
        info = options.info,
        flag = options.flag or self:next_flag(),
        type = string.lower(options.type or "toggle"),
        default = options.default == true,
        folding = options.folding or false,
        callback = options.callback or function() end,
        seperator = options.seperator or options.Seperator or false,
        items = {},
    }

    flags[cfg.flag] = cfg.default
    local rowHeight = cfg.info and 42 or 24
    local row, name, info, rightComponents = createElementRow(self, cfg, rowHeight)
    cfg.items.toggle = row
    cfg.items.name = name
    cfg.items.info = info
    cfg.items.right_components = rightComponents

    if cfg.type == "checkbox" then
        cfg.items.toggle_button = makeButton({
            Parent = rightComponents,
            Size = offset(17, 17),
            BackgroundColor3 = palette.control,
            LayoutOrder = 100,
            ZIndex = 9,
        })
        library:apply_theme(cfg.items.toggle_button, "accent", "BackgroundColor3")
        makeCorner(cfg.items.toggle_button, 4)
        makeStroke(cfg.items.toggle_button, palette.border, 0, 1)

        cfg.items.tick = library:create("Frame", {
            Parent = cfg.items.toggle_button,
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Visible = false,
            ZIndex = 10,
        })
        library:create("Frame", {
            Parent = cfg.items.tick,
            Position = offset(4, 8),
            Size = offset(2, 6),
            BackgroundColor3 = palette.text,
            BorderSizePixel = 0,
            Rotation = -42,
            ZIndex = 11,
        })
        library:create("Frame", {
            Parent = cfg.items.tick,
            Position = offset(9, 4),
            Size = offset(2, 10),
            BackgroundColor3 = palette.text,
            BorderSizePixel = 0,
            Rotation = 42,
            ZIndex = 11,
        })
    else
        cfg.type = "toggle"
        cfg.items.toggle_button = makeButton({
            Parent = rightComponents,
            Size = offset(34, 18),
            BackgroundColor3 = palette.control,
            LayoutOrder = 100,
            ZIndex = 9,
        })
        library:apply_theme(cfg.items.toggle_button, "accent", "BackgroundColor3")
        makeCorner(cfg.items.toggle_button, 9)
        makeStroke(cfg.items.toggle_button, palette.border, 0.25, 1)

        cfg.items.circle = library:create("Frame", {
            Parent = cfg.items.toggle_button,
            Position = offset(3, 3),
            Size = offset(12, 12),
            BackgroundColor3 = palette.textMuted,
            BorderSizePixel = 0,
            ZIndex = 10,
        })
        makeCorner(cfg.items.circle, 6)
    end

    function cfg.set(enabled)
        enabled = enabled == true
        cfg.enabled = enabled
        flags[cfg.flag] = enabled

        if cfg.type == "checkbox" then
            cfg.items.toggle_button.BackgroundColor3 = enabled and themes.preset.accent or palette.control
            cfg.items.tick.Visible = enabled
        else
            cfg.items.toggle_button.BackgroundColor3 = enabled and themes.preset.accent or palette.control
            cfg.items.circle.BackgroundColor3 = enabled and palette.text or palette.textMuted
            library:tween(cfg.items.circle, {
                Position = enabled and offset(19, 3) or offset(3, 3),
            }, Enum.EasingStyle.Quad, 0.14)
        end

        if cfg.folding and options.elements then
            options.elements.Visible = enabled
        end
        safeCall(cfg.callback, enabled)
    end

    local function toggleValue(input)
        if isPrimaryInput(input) then
            cfg.set(not cfg.enabled)
        end
    end
    library:connection(row.InputBegan, toggleValue)
    library:connection(cfg.items.toggle_button.InputBegan, toggleValue)

    if cfg.seperator then
        addElementDivider(self)
    end

    cfg.set(cfg.default)
    config_flags[cfg.flag] = cfg.set
    return setmetatable(cfg, library)
end

function library:slider(options)

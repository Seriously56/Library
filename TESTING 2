local Camera = workspace.CurrentCamera

local function rgb(r, g, b)
    return Color3.fromRGB(r, g, b)
end

local function offset(x, y)
    return UDim2.fromOffset(x, y)
end

local function isPrimaryInput(input)
    return input.UserInputType == Enum.UserInputType.MouseButton1
        or input.UserInputType == Enum.UserInputType.Touch
end

local function isPointerMovement(input)
    return input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch
end

local function safeCall(callback, ...)
    if type(callback) ~= "function" then
        return
    end

    local ok, result = pcall(callback, ...)
    if not ok then
        warn("RX Graphite UI callback error: " .. tostring(result))
    end

    return result
end

local function trim(text)
    return tostring(text or ""):match("^%s*(.-)%s*$")
end

local function clampPopupPosition(x, y, width, height)
    local viewport = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
    local maxX = math.max(8, viewport.X - width - 8)
    local maxY = math.max(8, viewport.Y - height - 8)
    return math.clamp(x, 8, maxX), math.clamp(y, 8, maxY)
end

local function resolveGuiParent(gui)
    local candidates = {}

    if type(gethui) == "function" then
        local ok, parent = pcall(gethui)
        if ok and parent then
            table.insert(candidates, parent)
        end
    end

    table.insert(candidates, Services.CoreGui)

    local localPlayer = Players.LocalPlayer
    if localPlayer then
        local playerGui = localPlayer:FindFirstChildOfClass("PlayerGui")
            or localPlayer:WaitForChild("PlayerGui", 3)
        if playerGui then
            table.insert(candidates, playerGui)
        end
    end

    for _, candidate in ipairs(candidates) do
        local ok = pcall(function()
            gui.Parent = candidate
        end)
        if ok and gui.Parent == candidate then
            return candidate
        end
    end

    return nil
end


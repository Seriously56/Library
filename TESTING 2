    })
    makeCorner(cfg.items.input, 4)
    makeStroke(cfg.items.input, palette.border, 0, 1)

    local function updateVisuals()
        cfg.items.colorpicker.BackgroundColor3 = cfg.color
        cfg.items.colorpicker_inline.BackgroundColor3 = cfg.color
        cfg.items.saturation_holder.BackgroundColor3 = Color3.fromHSV(h, 1, 1)
        cfg.items.satvalpicker.BackgroundColor3 = cfg.color
        cfg.items.alpha_gradient.BackgroundColor3 = cfg.color
        cfg.items.satvalpicker.Position = UDim2.new(s, 0, 1 - v, 0)
        cfg.items.hue_picker.Position = UDim2.new(h, 0, 0.5, 0)
        cfg.items.alpha_picker.Position = UDim2.new(a, 0, 0.5, 0)
        cfg.items.input.Text = string.format(
            "%d, %d, %d, %.2f",
            math.floor(cfg.color.R * 255 + 0.5),
            math.floor(cfg.color.G * 255 + 0.5),
            math.floor(cfg.color.B * 255 + 0.5),
            1 - a
        )
    end

    function cfg.set(colorValue, transparency)
        if type(colorValue) == "table" and colorValue.Color then
            transparency = colorValue.Transparency
            colorValue = colorValue.Color
        end
        if typeof(colorValue) == "Color3" then
            cfg.color = colorValue
            h, s, v = cfg.color:ToHSV()
        end
        if transparency ~= nil then
            a = math.clamp(tonumber(transparency) or 0, 0, 1)
            cfg.alpha = a
        end

        flags[cfg.flag] = {Color = cfg.color, Transparency = a}
        updateVisuals()
        safeCall(cfg.callback, cfg.color, a)
    end

    function cfg.update_color()
        cfg.set(Color3.fromHSV(h, s, v), a)
    end

    function cfg.set_visible(visible)
        visible = visible == true
        cfg.open = visible
        local holder = cfg.items.colorpicker_holder
        if visible then
            library:close_element(cfg)
            local swatch = cfg.items.colorpicker
            local absolute = swatch.AbsolutePosition
            local viewport = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
            local popupScale = math.min(1, (viewport.X - 16) / 198, (viewport.Y - 16) / 232)
            cfg.items.popup_scale.Scale = math.max(0.1, popupScale)
            local popupWidth = 198 * cfg.items.popup_scale.Scale
            local popupHeight = 232 * cfg.items.popup_scale.Scale
            local x, y = clampPopupPosition(
                absolute.X + swatch.AbsoluteSize.X - popupWidth,
                absolute.Y + swatch.AbsoluteSize.Y + 5,
                popupWidth,
                popupHeight
            )
            holder.Position = offset(x, y)
            holder.Visible = true
        else
            holder.Visible = false
            if library.current_open == cfg then
                library.current_open = nil
            end
        end
    end

    local function updateSat(position)
        local field = cfg.items.saturation_holder
        s = math.clamp((position.X - field.AbsolutePosition.X) / math.max(field.AbsoluteSize.X, 1), 0, 1)
        v = 1 - math.clamp((position.Y - field.AbsolutePosition.Y) / math.max(field.AbsoluteSize.Y, 1), 0, 1)
        cfg.set(Color3.fromHSV(h, s, v), a)
    end

    local function updateHue(position)
        local field = cfg.items.hue_gradient
        h = math.clamp((position.X - field.AbsolutePosition.X) / math.max(field.AbsoluteSize.X, 1), 0, 1)
        cfg.set(Color3.fromHSV(h, s, v), a)
    end

    local function updateAlpha(position)
        local field = cfg.items.alpha_checker
        a = math.clamp((position.X - field.AbsolutePosition.X) / math.max(field.AbsoluteSize.X, 1), 0, 1)
        cfg.set(Color3.fromHSV(h, s, v), a)
    end

    library:connection(cfg.items.colorpicker.InputBegan, function(input)
        if isPrimaryInput(input) then
            cfg.set_visible(not cfg.open)
        end
    end)
    library:connection(cfg.items.sat.InputBegan, function(input)
        if isPrimaryInput(input) then
            draggingSat = true
            updateSat(input.Position)
        end
    end)
    library:connection(cfg.items.hue_gradient.InputBegan, function(input)
        if isPrimaryInput(input) then
            draggingHue = true
            updateHue(input.Position)
        end
    end)
    library:connection(cfg.items.alpha_gradient.InputBegan, function(input)
        if isPrimaryInput(input) then
            draggingAlpha = true
            updateAlpha(input.Position)
        end
    end)
    library:connection(UserInputService.InputChanged, function(input)
        if not isPointerMovement(input) then
            return
        end
        if draggingSat then
            updateSat(input.Position)
        elseif draggingHue then
            updateHue(input.Position)
        elseif draggingAlpha then
            updateAlpha(input.Position)
        end
    end)
    library:connection(UserInputService.InputEnded, function(input)
        if isPrimaryInput(input) then
            draggingSat = false
            draggingHue = false
            draggingAlpha = false
        end
    end)
    library:connection(cfg.items.input.FocusLost, function()
        local red, green, blue, opacity = library:convert(cfg.items.input.Text)
        if red and green and blue and opacity then
            cfg.set(rgb(
                math.clamp(red, 0, 255),
                math.clamp(green, 0, 255),
                math.clamp(blue, 0, 255)
            ), 1 - math.clamp(opacity, 0, 1))
        else
            updateVisuals()
        end
    end)

    cfg.set(cfg.color, a)
    config_flags[cfg.flag] = cfg.set
    return setmetatable(cfg, library)
end


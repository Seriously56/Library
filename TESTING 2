            Parent = items.multi_section_button_holder,
            Size = offset(math.max(88, #tostring(pageName) * 7 + 26), 38),
            BackgroundColor3 = palette.surface,
            BackgroundTransparency = 1,
            LayoutOrder = pageIndex,
            ClipsDescendants = true,
            ZIndex = 6,
        })
        makeCorner(pageItems.button, 5)

        pageItems.name = makeLabel({
            Parent = pageItems.button,
            Size = UDim2.new(1, -16, 1, -3),
            Position = offset(8, 0),
            Text = tostring(pageName),
            Font = Enum.Font.GothamMedium,
            TextSize = 12,
            TextColor3 = palette.textMuted,
            ZIndex = 7,
        })

        pageItems.accent = library:create("Frame", {
            Parent = pageItems.button,
            AnchorPoint = Vector2.new(0.5, 1),
            Position = UDim2.new(0.5, 0, 1, 0),
            Size = UDim2.new(1, -22, 0, 2),
            BackgroundColor3 = themes.preset.accent,
            BorderSizePixel = 0,
            Visible = false,
            ZIndex = 8,
        })
        makeCorner(pageItems.accent, 1)
        library:apply_theme(pageItems.accent, "accent", "BackgroundColor3")

        pageItems.tab = library:create("Frame", {
            Parent = nil,
            Position = offset(0, 0),
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            Visible = false,
            ZIndex = 3,
        })

        data.text = pageItems.name
        data.accent = pageItems.accent
        data.button = pageItems.button
        data.page = pageItems.tab

        setmetatable(data, library)
        data.parent = data:sub_tab({}).items.tab_parent

        function data.open_page()
            if cfg.current_multi == data then
                return
            end

            local old = cfg.current_multi
            if old then
                old.page.Visible = false
                old.page.Parent = nil
                old.button.BackgroundTransparency = 1
                old.text.TextColor3 = palette.textMuted
                old.accent.Visible = false
            end

            window.items.global_fade.BackgroundTransparency = 0.72
            library:tween(window.items.global_fade, {BackgroundTransparency = 1}, Enum.EasingStyle.Quad, 0.18)

            data.page.Parent = items.tab_holder
            data.page.Visible = true
            data.button.BackgroundTransparency = 0
            data.text.TextColor3 = palette.text
            data.accent.Visible = true
            cfg.current_multi = data
            library:close_element()
        end

        library:connection(pageItems.button.InputBegan, function(input)
            if isPrimaryInput(input) then
                data.open_page()
            end
        end)

        table.insert(cfg.pages, data)
    end

    function cfg.open_tab()
        if window.selected_tab == cfg then
            return
        end

        local old = window.selected_tab
        if old then
            old.items.tab_holder.Visible = false
            old.items.tab_holder.Parent = nil
            old.items.multi_section_button_holder.Visible = false
            old.items.multi_section_button_holder.Parent = nil
            old.items.button.BackgroundTransparency = 1
            old.items.active_bar.Visible = false
            old.items.name.TextColor3 = palette.textSoft
            old.items.icon.ImageColor3 = palette.textMuted
            old.items.icon_fallback.TextColor3 = palette.textMuted
        end

        window.items.global_fade.BackgroundTransparency = 0.72
        library:tween(window.items.global_fade, {BackgroundTransparency = 1}, Enum.EasingStyle.Quad, 0.18)

        items.tab_holder.Parent = window.items.content_host
        items.tab_holder.Visible = true
        items.multi_section_button_holder.Parent = window.items.multi_holder
        items.multi_section_button_holder.Visible = true
        items.button.BackgroundTransparency = 0
        items.active_bar.Visible = true
        items.name.TextColor3 = palette.text
        items.icon.ImageColor3 = themes.preset.accent
        items.icon_fallback.TextColor3 = themes.preset.accent
        window.selected_tab = cfg
        library:close_element()

        if not cfg.current_multi and cfg.pages[1] then
            cfg.pages[1].open_page()
        end
    end

    library:connection(items.button.InputBegan, function(input)
        if isPrimaryInput(input) then
            cfg.open_tab()
        end
    end)

    library:connection(items.button.MouseEnter, function()
        if window.selected_tab ~= cfg then
            library:tween(items.button, {BackgroundTransparency = 0.45}, Enum.EasingStyle.Quad, 0.12)
        end
    end)
    library:connection(items.button.MouseLeave, function()
        if window.selected_tab ~= cfg then
            library:tween(items.button, {BackgroundTransparency = 1}, Enum.EasingStyle.Quad, 0.12)
        end
    end)

    table.insert(window.tabs, cfg)
    if not window.selected_tab then
        cfg.open_tab()
    end

    return table.unpack(cfg.pages)
end


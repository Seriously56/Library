    local contentHost = self:create("Frame", {
        Parent = main,
        Position = offset(196, 56),
        Size = UDim2.new(1, -196, 1, -82),
        BackgroundColor3 = palette.canvas,
        BorderSizePixel = 0,
        ClipsDescendants = true,
        ZIndex = 2,
    })
    cfg.items.content_host = contentHost

    local globalFade = self:create("Frame", {
        Parent = main,
        Position = offset(196, 56),
        Size = UDim2.new(1, -196, 1, -82),
        BackgroundColor3 = palette.canvas,
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 90,
    })
    cfg.items.global_fade = globalFade

    self:draggify(main, brandHeader)
    self:draggify(main, multiHolder)
    if properties.resizable ~= false and properties.Resizable ~= false then
        self:resizify(main)
    end

    local touchMenuVisible = true

    function cfg.toggle_menu(visible)
        local currentlyVisible = UserInputService.TouchEnabled and main.Visible or screenGui.Enabled
        if visible == nil then
            visible = not currentlyVisible
        end
        visible = visible == true
        if UserInputService.TouchEnabled then
            touchMenuVisible = visible
            main.Visible = visible
            shadow.Visible = visible
            popupGui.Enabled = visible
        else
            screenGui.Enabled = visible
            popupGui.Enabled = visible
        end
        return visible
    end

    function cfg.set_game_info(text)
        cfg.game_name = tostring(text or "")
        cfg.items.game.Text = cfg.game_name
    end

    if UserInputService.TouchEnabled then
        local launcher = makeButton({
            Parent = screenGui,
            Position = offset(14, 14),
            Size = offset(42, 42),
            BackgroundColor3 = palette.surfaceRaised,
            ZIndex = 200,

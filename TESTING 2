        makeCorner(launcher, 8)
        makeStroke(launcher, palette.border, 0, 1)
        local launcherMark = buildRXMark(launcher, 28, 201)
        launcherMark.Position = offset(7, 7)
        self:connection(launcher.InputBegan, function(input)
            if isPrimaryInput(input) then
                cfg.toggle_menu(not touchMenuVisible)
            end
        end)
        cfg.items.launcher = launcher
    end

    return setmetatable(cfg, library)
end



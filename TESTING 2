local configHolder

local function filesystemAvailable()
    return type(isfolder) == "function"
        and type(makefolder) == "function"
        and type(listfiles) == "function"
        and type(isfile) == "function"
        and type(readfile) == "function"
        and type(writefile) == "function"
end

local function ensureConfigDirectories()
    if not filesystemAvailable() then
        return false
    end

    local ok = pcall(function()
        if not isfolder(library.directory) then
            makefolder(library.directory)
        end
        for _, folder in ipairs(library.folders) do
            local path = library.directory .. folder
            if not isfolder(path) then
                makefolder(path)
            end
        end
    end)
    return ok
end

local function configPath(name)
    local clean = trim(name):gsub("[\\/:*?\"<>|]", "_")
    if clean == "" then
        clean = "default"
    end
    return library.directory .. "/configs/" .. clean .. ".cfg", clean
end

function library:update_config_list()
    if not configHolder or not filesystemAvailable() or not ensureConfigDirectories() then
        return {}
    end

    local names = {}
    local ok, files = pcall(listfiles, self.directory .. "/configs")
    if ok and type(files) == "table" then
        for _, file in ipairs(files) do
            local normalized = tostring(file):gsub("\\", "/")
            local name = normalized:match("([^/]+)%.cfg$")
            if name then
                table.insert(names, name)
            end
        end
    end
    table.sort(names)
    configHolder.refresh_options(names)
    return names
end

function library:get_config()
    local encoded = {}

    for flag, value in pairs(flags) do
        if type(value) == "table" and value.key ~= nil then
            encoded[flag] = {
                active = value.active == true,
                mode = value.mode,
                key = tostring(value.key),
            }
        elseif type(value) == "table" and value.Transparency ~= nil and typeof(value.Color) == "Color3" then
            encoded[flag] = {
                Transparency = value.Transparency,
                Color = value.Color:ToHex(),
            }
        else
            encoded[flag] = value
        end
    end

    return HttpService:JSONEncode(encoded)
end

function library:load_config(configJson)
    local ok, decoded = pcall(function()
        return HttpService:JSONDecode(configJson)
    end)
    if not ok or type(decoded) ~= "table" then
        return false, "Invalid configuration data"
    end

    for flag, value in pairs(decoded) do
        local setter = config_flags[flag]
        if setter and flag ~= "config_name_list" then
            if type(value) == "table" and value.Transparency ~= nil and value.Color then
                local colorOk, restoredColor = pcall(Color3.fromHex, value.Color)
                if colorOk then
                    safeCall(setter, restoredColor, value.Transparency)
                end
            else
                safeCall(setter, value)
            end
        end
    end

    return true
end

function library:init_config(window)
    assert(window and window.items, "init_config requires a window returned by library:window")

    window:seperator({name = "Settings"})
    local page = window:tab({name = "Config", tabs = {"Profiles"}})
    if not page then
        return nil
    end

    local leftColumn = page:column({})
    local profiles = leftColumn:section({name = "Profiles", size = 1})
    configHolder = profiles:list({
        options = {},
        flag = "config_name_list",
        callback = function(selected)
            if library.flags.config_name_text ~= selected and config_flags.config_name_text then
                config_flags.config_name_text(selected)
            end
        end,
    })

    local rightColumn = page:column({})
    local settingsSection = rightColumn:section({name = "Configuration", size = 1})
    local nameInput = settingsSection:textbox({
        name = "Profile name",
        flag = "config_name_text",
        placeholder = "default",
    })

    local function notifyResult(title, info)
        notifications:create_notification({name = title, info = info, lifetime = 4})
    end

    settingsSection:button({
        name = "Save profile",
        callback = function()
            if not ensureConfigDirectories() then
                notifyResult("Profiles", "File access is unavailable in this environment.")
                return
            end
            local path, clean = configPath(flags.config_name_text)
            local ok, err = pcall(writefile, path, library:get_config())
            if ok then
                library:update_config_list()
                notifyResult("Profiles", "Saved " .. clean .. ".")
            else
                notifyResult("Profiles", "Save failed: " .. tostring(err))
            end
        end,
    })

    settingsSection:button({
        name = "Load profile",
        callback = function()
            if not ensureConfigDirectories() then
                notifyResult("Profiles", "File access is unavailable in this environment.")
                return
            end
            local path, clean = configPath(flags.config_name_text)
            if not isfile(path) then
                notifyResult("Profiles", clean .. " does not exist.")
                return
            end
            local readOk, contents = pcall(readfile, path)
            local loadOk, err = readOk and library:load_config(contents)
            if loadOk then
                notifyResult("Profiles", "Loaded " .. clean .. ".")
            else
                notifyResult("Profiles", "Load failed: " .. tostring(err or contents))
            end
        end,
    })

    settingsSection:button({
        name = "Delete profile",
        callback = function()
            if not ensureConfigDirectories() or type(delfile) ~= "function" then
                notifyResult("Profiles", "Delete access is unavailable in this environment.")
                return
            end
            local path, clean = configPath(flags.config_name_text)
            if isfile(path) then
                local ok, err = pcall(delfile, path)
                if not ok then
                    notifyResult("Profiles", "Delete failed: " .. tostring(err))
                    return
                end
            end
            library:update_config_list()
            nameInput.set("")
            notifyResult("Profiles", "Deleted " .. clean .. ".")
        end,
    })

    settingsSection:colorpicker({
        name = "Accent color",
        flag = "menu_accent",
        color = themes.preset.accent,
        callback = function(color)
            library:update_theme("accent", color)
        end,
    })

    settingsSection:keybind({
        name = "Menu bind",
        flag = "menu_bind",
        key = Enum.KeyCode.Insert,
        mode = "Toggle",
        default = true,
        callback = function(visible)
            window.toggle_menu(visible)
        end,
    })

    ensureConfigDirectories()
    library:update_config_list()
    return {
        page = page,
        list = configHolder,
        input = nameInput,
    }
end

local function ensureNotificationRoot()
    if library.other and library.other.Parent then
        return library.other
    end

    local gui = library:create("ScreenGui", {
        Name = "RXGraphiteNotifications",
        Enabled = true,
        ResetOnSpawn = false,
        IgnoreGuiInset = true,
        ZIndexBehavior = Enum.ZIndexBehavior.Global,
        DisplayOrder = 120,
    })
    resolveGuiParent(gui)
    library.other = gui
    return gui
end

function notifications:refresh_notifs()
    local y = 18
    for _, notification in ipairs(self.notifs) do
        library:tween(notification, {Position = offset(18, y)}, Enum.EasingStyle.Quad, 0.18)
        y = y + notification.AbsoluteSize.Y + 9
    end
    return y
end

function notifications:fade(path, isFading)
    if not path then
        return
    end
    local target = isFading and 1 or 0
    library:tween(path, {BackgroundTransparency = isFading and 1 or 0.04}, Enum.EasingStyle.Quad, 0.18)

    for _, instance in ipairs(path:GetDescendants()) do
        if instance:IsA("TextLabel") then
            library:tween(instance, {TextTransparency = target}, Enum.EasingStyle.Quad, 0.18)
        elseif instance:IsA("UIStroke") then
            library:tween(instance, {Transparency = target}, Enum.EasingStyle.Quad, 0.18)
        elseif instance:IsA("Frame") then
            local original = instance:GetAttribute("RXOriginalTransparency")
            if original == nil then
                original = instance.BackgroundTransparency
                instance:SetAttribute("RXOriginalTransparency", original)
            end
            library:tween(instance, {BackgroundTransparency = isFading and 1 or original}, Enum.EasingStyle.Quad, 0.18)
        end
    end
end

function notifications:create_notification(options)
    options = options or {}
    local cfg = {
        name = options.name or "Notice",
        info = options.info or "",
        lifetime = tonumber(options.lifetime) or 3,
        items = {},
    }

    local root = ensureNotificationRoot()
    local notification = library:create("Frame", {
        Parent = root,
        Position = offset(-260, 18),
        Size = offset(240, 58),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = palette.surfaceRaised,
        BackgroundTransparency = 0.04,
        BorderSizePixel = 0,
        ZIndex = 400,
    })
    cfg.items.notification = notification
    makeCorner(notification, 6)
    makeStroke(notification, palette.border, 0, 1)

    cfg.items.title = makeLabel({
        Parent = notification,
        Position = offset(11, 8),
        Size = UDim2.new(1, -22, 0, 16),
        Text = tostring(cfg.name),
        Font = Enum.Font.GothamBold,
        TextSize = 12,
        TextColor3 = palette.text,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        ZIndex = 401,
    })

    cfg.items.info = makeLabel({
        Parent = notification,
        Position = offset(11, 27),
        Size = UDim2.new(1, -22, 0, 17),
        AutomaticSize = Enum.AutomaticSize.Y,
        Text = tostring(cfg.info),
        Font = Enum.Font.Gotham,
        TextSize = 11,
        TextColor3 = palette.textSoft,
        TextWrapped = true,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = 401,
    })
    makePadding(notification, 0, 0, 0, 12)

    cfg.items.progress_track = library:create("Frame", {
        Name = "ProgressTrack",
        Parent = notification,
        AnchorPoint = Vector2.new(0, 1),
        Position = UDim2.new(0, 10, 1, -7),
        Size = UDim2.new(1, -20, 0, 2),
        BackgroundColor3 = palette.divider,
        BorderSizePixel = 0,
        ZIndex = 401,
    })
    makeCorner(cfg.items.progress_track, 1)

    cfg.items.bar = library:create("Frame", {
        Parent = cfg.items.progress_track,
        Size = UDim2.fromScale(1, 1),
        BackgroundColor3 = themes.preset.accent,
        BorderSizePixel = 0,
        ZIndex = 402,
    })
    makeCorner(cfg.items.bar, 1)
    library:apply_theme(cfg.items.bar, "accent", "BackgroundColor3")

    table.insert(self.notifs, notification)
    self:refresh_notifs()
    library:tween(notification, {Position = offset(18, notification.Position.Y.Offset)}, Enum.EasingStyle.Quad, 0.22)
    library:tween(cfg.items.bar, {Size = UDim2.new(0, 0, 1, 0)}, Enum.EasingStyle.Linear, cfg.lifetime)

    task.delay(cfg.lifetime, function()
        local index = table.find(self.notifs, notification)
        if index then
            table.remove(self.notifs, index)
        end
        self:fade(notification, true)
        library:tween(notification, {Position = offset(-260, notification.Position.Y.Offset)}, Enum.EasingStyle.Quad, 0.2)
        task.delay(0.22, function()
            if notification.Parent then
                notification:Destroy()
            end
            self:refresh_notifs()
        end)
    end)

    return setmetatable(cfg, library)
end

function library:notify(options)
    if type(options) == "string" then
        options = {info = options}
    end
    return notifications:create_notification(options)
end

return library

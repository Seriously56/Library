        cfg.items.name.Text = cfg.name
    end

    function cfg.set(value)
        value = tonumber(value) or cfg.min
        cfg.value = math.clamp(library:round(value, cfg.intervals), cfg.min, cfg.max)
        local range = cfg.max - cfg.min
        local alpha = range == 0 and 0 or (cfg.value - cfg.min) / range
        cfg.items.fill.Size = UDim2.new(alpha, 0, 1, 0)
        cfg.items.value.Text = tostring(cfg.value) .. cfg.suffix
        flags[cfg.flag] = cfg.value
        safeCall(cfg.callback, cfg.value)
    end

    local function setFromPosition(position)
        local track = cfg.items.slider
        local alpha = math.clamp((position.X - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1), 0, 1)
        cfg.set(cfg.min + (cfg.max - cfg.min) * alpha)
    end

    library:connection(cfg.items.slider.InputBegan, function(input)
        if isPrimaryInput(input) then
            cfg.dragging = true
            cfg.items.value.TextColor3 = palette.text
            setFromPosition(input.Position)
        end
    end)
    library:connection(UserInputService.InputChanged, function(input)
        if cfg.dragging and isPointerMovement(input) then
            setFromPosition(input.Position)
        end
    end)
    library:connection(UserInputService.InputEnded, function(input)
        if isPrimaryInput(input) then
            cfg.dragging = false
            cfg.items.value.TextColor3 = palette.textMuted
        end
    end)

    if cfg.seperator then
        addElementDivider(self)
    end
    cfg.set(cfg.default)
    config_flags[cfg.flag] = cfg.set
    return setmetatable(cfg, library)
end


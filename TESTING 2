    local cfg = {
        name = options.name,
        suffix = options.suffix or "",
        flag = options.flag or self:next_flag(),
        callback = options.callback or function() end,
        info = options.info,
        min = options.min or options.minimum or 0,
        max = options.max or options.maximum or 100,
        intervals = options.interval or options.decimal or 1,
        default = options.default == nil and 10 or options.default,
        value = options.default == nil and 10 or options.default,
        seperator = options.seperator or options.Seperator or false,
        dragging = false,
        items = {},
    }

    flags[cfg.flag] = cfg.default
    local rowHeight = cfg.info and 62 or 44
    local row, name, info, rightComponents = createElementRow(self, cfg, rowHeight)
    cfg.items.slider_object = row

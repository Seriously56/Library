local function makeLabel(properties)
    properties = properties or {}
    properties.BackgroundTransparency = properties.BackgroundTransparency == nil and 1 or properties.BackgroundTransparency
    properties.BorderSizePixel = 0
    properties.Font = properties.Font or Enum.Font.Gotham
    properties.TextColor3 = properties.TextColor3 or palette.text
    properties.TextSize = properties.TextSize or 13
    properties.Text = properties.Text or ""
    return library:create("TextLabel", properties)
end

local function makeButton(properties)
    properties = properties or {}
    properties.AutoButtonColor = false
    properties.BorderSizePixel = 0
    properties.Text = properties.Text or ""
    properties.Font = properties.Font or Enum.Font.Gotham
    return library:create("TextButton", properties)
end

local function setVisible(instance, visible)
    if instance then
        instance.Visible = visible
    end
end

function library:tween(object, properties, easingStyle, duration)
    if not object or not object.Parent then
        return nil
    end

    local tween = TweenService:Create(
        object,
        TweenInfo.new(duration or 0.18, easingStyle or Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        properties
    )
    tween:Play()
    return tween
end

function library:connection(signal, callback)
    local connection = signal:Connect(callback)
    table.insert(library.connections, connection)
    return connection
end

function library:create(className, properties)
    local object = Instance.new(className)
    for property, value in pairs(properties or {}) do
        object[property] = value
    end
    return object
end

function library:next_flag()
    local index = 0
    for _ in pairs(library.flags) do
        index = index + 1
    end
    return string.format("flagnumber%s", index + 1)
end

function library:round(number, interval)
    local multiplier = 1 / (interval or 1)
    return math.floor(number * multiplier + 0.5) / multiplier
end

function library:mouse_in_frame(object)
    if not object or not object.Visible then
        return false
    end

    local mousePosition = UserInputService:GetMouseLocation()
    local position = object.AbsolutePosition
    local size = object.AbsoluteSize
    return mousePosition.X >= position.X
        and mousePosition.X <= position.X + size.X
        and mousePosition.Y >= position.Y
        and mousePosition.Y <= position.Y + size.Y
end

function library:convert(text)
    local values = {}
    for value in tostring(text):gmatch("[^,]+") do
        table.insert(values, tonumber(trim(value)))
    end
    if #values == 4 then
        return table.unpack(values)
    end
end

function library:convert_enum(enumText)
    if typeof(enumText) == "EnumItem" then
        return enumText
    end

    local current = Enum
    for part in tostring(enumText):gmatch("[%w_]+") do
        if part ~= "Enum" then
            current = current and current[part]
        end
    end
    return current
end

function library:apply_theme(instance, theme, property)
    local themeTable = themes.utility[theme]
    if themeTable and themeTable[property] then
        table.insert(themeTable[property], instance)
    end
end

function library:update_theme(theme, color)
    local utility = themes.utility[theme]
    local previous = themes.preset[theme]
    if not utility or typeof(color) ~= "Color3" then
        return
    end

    for property, objects in pairs(utility) do
        for index = #objects, 1, -1 do
            local object = objects[index]
            if not object or not object.Parent then
                table.remove(objects, index)
            else
                local ok, value = pcall(function()
                    return object[property]
                end)
                if ok and value == previous then
                    pcall(function()
                        object[property] = color
                    end)
                end
            end
        end
    end

    themes.preset[theme] = color
    palette.accent = color
end

function library:close_element(newPath)
    local opened = library.current_open
    if opened and opened ~= newPath and type(opened.set_visible) == "function" then
        opened.set_visible(false)
        opened.open = false
    end
    if opened ~= newPath then
        library.current_open = newPath
    end
end

function library:draggify(frame, handle)
    handle = handle or frame
    local dragging = false
    local dragStart
    local startPosition

    self:connection(handle.InputBegan, function(input)
        if not isPrimaryInput(input) then
            return
        end
        dragging = true
        dragStart = input.Position
        startPosition = frame.Position
        self:close_element()
    end)

    self:connection(UserInputService.InputEnded, function(input)
        if isPrimaryInput(input) then
            dragging = false
        end
    end)

    self:connection(UserInputService.InputChanged, function(input)
        if not dragging or not isPointerMovement(input) then
            return
        end

        local delta = input.Position - dragStart
        frame.Position = UDim2.new(
            startPosition.X.Scale,
            startPosition.X.Offset + delta.X,
            startPosition.Y.Scale,
            startPosition.Y.Offset + delta.Y
        )
    end)
end

function library:resizify(frame)
    local handle = makeButton({
        Parent = frame,
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, 0, 1, 0),
        Size = offset(18, 18),
        BackgroundTransparency = 1,
        ZIndex = 100,
    })

    local grip = self:create("Frame", {
        Parent = handle,
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.new(1, -4, 1, -4),
        Size = offset(9, 9),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ZIndex = 101,
    })
    self:create("Frame", {
        Parent = grip,
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.fromScale(1, 1),
        Size = offset(8, 2),
        BackgroundColor3 = palette.textMuted,
        BorderSizePixel = 0,
        ZIndex = 102,
    })
    self:create("Frame", {
        Parent = grip,
        AnchorPoint = Vector2.new(1, 1),
        Position = UDim2.fromScale(1, 1),
        Size = offset(2, 8),
        BackgroundColor3 = palette.textMuted,
        BorderSizePixel = 0,
        ZIndex = 102,
    })

    local resizing = false
    local start
    local startSize
    local startScale = 1
    local minimum = Vector2.new(620, 420)

    self:connection(handle.InputBegan, function(input)
        if isPrimaryInput(input) then
            resizing = true
            start = input.Position
            local scaleObject = frame:FindFirstChildOfClass("UIScale")
            startScale = math.max(scaleObject and scaleObject.Scale or 1, 0.01)
            startSize = Vector2.new(frame.Size.X.Offset, frame.Size.Y.Offset)
            if startSize.X <= 0 or startSize.Y <= 0 then
                startSize = frame.AbsoluteSize / startScale
            end
        end
    end)

    self:connection(UserInputService.InputEnded, function(input)
        if isPrimaryInput(input) then
            resizing = false
        end
    end)

    self:connection(UserInputService.InputChanged, function(input)
        if not resizing or not isPointerMovement(input) then
            return
        end

        local viewport = Camera and Camera.ViewportSize or Vector2.new(1920, 1080)
        local delta = input.Position - start
        local maximum = Vector2.new(
            math.max(1, (viewport.X - 12) / startScale),
            math.max(1, (viewport.Y - 12) / startScale)
        )
        local effectiveMinimum = Vector2.new(
            math.min(minimum.X, maximum.X),
            math.min(minimum.Y, maximum.Y)
        )
        frame.Size = offset(
            math.clamp(startSize.X + delta.X / startScale, effectiveMinimum.X, maximum.X),
            math.clamp(startSize.Y + delta.Y / startScale, effectiveMinimum.Y, maximum.Y)
        )
    end)

    return handle
end

function library:unload_menu()
    library.unloaded = true
    library:close_element()
    library.current_open = nil
    table.clear(library.notifications.notifs)

    for _, connection in ipairs(library.connections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    table.clear(library.connections)

    if library.items then
        library.items:Destroy()
        library.items = nil
    end
    if library.other then
        library.other:Destroy()
        library.other = nil
    end
end

local function buildRXMark(parent, size, zIndex)
    local mark = library:create("Frame", {
        Parent = parent,
        BackgroundTransparency = 1,
        Size = offset(size, size),
        ZIndex = zIndex,
    })

    makeLabel({
        Parent = mark,
        Position = UDim2.fromScale(0, 0),
        Size = UDim2.fromScale(0.62, 1),
        Text = "R",
        Font = Enum.Font.GothamBold,
        TextSize = math.floor(size * 0.66),
        TextColor3 = palette.text,
        TextXAlignment = Enum.TextXAlignment.Center,
        ZIndex = zIndex + 1,
    })

    local x = makeLabel({
        Parent = mark,
        Position = UDim2.fromScale(0.39, 0),
        Size = UDim2.fromScale(0.61, 1),
        Text = "X",
        Font = Enum.Font.GothamBold,
        TextSize = math.floor(size * 0.66),
        TextColor3 = themes.preset.accent,
        TextXAlignment = Enum.TextXAlignment.Center,
        ZIndex = zIndex + 2,
    })
    library:apply_theme(x, "accent", "TextColor3")

    return mark
end

function library:window(properties)

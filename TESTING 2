        cfg.hold_instances[mode] = modeButton
        library:apply_theme(modeButton, "accent", "TextColor3")
        library:connection(modeButton.InputBegan, function(input)
            if isPrimaryInput(input) then
                cfg.set(mode)
                cfg.set_visible(false)
            end
        end)
    end

    local function keyText(key)
        if key == nil or key == "NONE" then
            return "NONE"
        end
        return keys[key] or tostring(key):gsub("Enum%.KeyCode%.", ""):gsub("Enum%.UserInputType%.", "")
    end

    local function syncKeybindState()
        cfg.items.key.Text = keyText(cfg.key)
        flags[cfg.flag] = {mode = cfg.mode, key = cfg.key, active = cfg.active}
        safeCall(cfg.callback, cfg.active)
    end

    function cfg.modify_mode_color(mode)
        for _, button in pairs(cfg.hold_instances) do
            button.TextColor3 = palette.textMuted
        end
        if cfg.hold_instances[mode] then
            cfg.hold_instances[mode].TextColor3 = themes.preset.accent
        end
    end

    function cfg.set_mode(mode, suppressSync)
        if not table.find(modes, mode) then
            mode = "Toggle"
        end
        cfg.mode = mode
        if mode == "Always" then
            cfg.active = true
        elseif mode == "Hold" then
            cfg.active = false
        end
        cfg.modify_mode_color(mode)
        if cfg.items.mode_text then
            cfg.items.mode_text.Text = string.upper(mode:sub(1, 1))
        end
        if not suppressSync then
            syncKeybindState()
        end
    end

    function cfg.set(input)
        if type(input) == "boolean" then
            cfg.active = cfg.mode == "Always" and true or input
        elseif typeof(input) == "EnumItem" then
            cfg.key = input == Enum.KeyCode.Escape and "NONE" or input
        elseif type(input) == "string" and table.find(modes, input) then
            cfg.set_mode(input, true)
        elseif type(input) == "table" then
            local restoredKey = input.key
            if type(restoredKey) == "string" and restoredKey ~= "NONE" then
                restoredKey = library:convert_enum(restoredKey) or restoredKey
            end
            cfg.key = restoredKey or "NONE"
            cfg.active = input.active == true
            cfg.set_mode(input.mode or cfg.mode, true)
        end

        syncKeybindState()
    end

    function cfg.set_visible(visible)
        visible = visible == true
        cfg.open = visible
        if visible then
            library:close_element(cfg)
            local holder = cfg.items.keybind_holder
            local absolute = holder.AbsolutePosition
            local viewport = Camera and Camera.ViewportSize or Vector2.new(1280, 720)
            local popupWidth = math.max(1, math.min(94, viewport.X - 16))
            local x, y = clampPopupPosition(absolute.X + holder.AbsoluteSize.X - popupWidth, absolute.Y + holder.AbsoluteSize.Y + 5, popupWidth, 84)
            cfg.items.dropdown.Position = offset(x, y)
            cfg.items.dropdown.Visible = true
            cfg.items.dropdown.Size = offset(popupWidth, 0)
            library:tween(cfg.items.dropdown, {Size = offset(popupWidth, 84)}, Enum.EasingStyle.Quad, 0.14)
        else
            library:tween(cfg.items.dropdown, {Size = offset(cfg.items.dropdown.Size.X.Offset, 0)}, Enum.EasingStyle.Quad, 0.1)
            task.delay(0.11, function()
                if not cfg.open and cfg.items.dropdown.Parent then
                    cfg.items.dropdown.Visible = false
                end
            end)
            if library.current_open == cfg then
                library.current_open = nil
            end
        end
    end

    library:connection(cfg.items.keybind_holder.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton2 then
            cfg.set_visible(not cfg.open)
            return
        end
        if not isPrimaryInput(input) or cfg.binding then
            return
        end

        cfg.items.key.Text = "..."
        cfg.binding = library:connection(UserInputService.InputBegan, function(keyInput)
            local selected = keyInput.UserInputType == Enum.UserInputType.Keyboard and keyInput.KeyCode or keyInput.UserInputType
            cfg.set(selected)
            if cfg.binding then
                cfg.binding:Disconnect()
                cfg.binding = nil
            end
        end)
    end)

    library:connection(cfg.items.mode_button.InputBegan, function(input)
        if isPrimaryInput(input) then
            cfg.set_visible(not cfg.open)
        end
    end)

    library:connection(UserInputService.InputBegan, function(input, processed)
        if processed or cfg.binding or cfg.ignore_key then
            return
        end
        local selected = input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode or input.UserInputType
        if selected == cfg.key then
            if cfg.mode == "Toggle" then
                cfg.set(not cfg.active)
            elseif cfg.mode == "Hold" then
                cfg.set(true)
            end
        end
    end)

    library:connection(UserInputService.InputEnded, function(input, processed)
        if processed or cfg.binding then
            return
        end
        local selected = input.UserInputType == Enum.UserInputType.Keyboard and input.KeyCode or input.UserInputType
        if selected == cfg.key and cfg.mode == "Hold" then
            cfg.set(false)
        end
    end)

    if cfg.seperator then
        addElementDivider(self)
    end
    cfg.set({mode = cfg.mode, active = cfg.active, key = cfg.key})
    config_flags[cfg.flag] = cfg.set
    return setmetatable(cfg, library)
end


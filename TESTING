local function ApplyDPIScale(Position)
    return UDim2.new(Position.X.Scale, Position.X.Offset * getgenv().DPIScale, Position.Y.Scale, Position.Y.Offset * getgenv().DPIScale)
end

local function ApplyTextScale(TextSize)
    return TextSize * getgenv().DPIScale
end

local function Create(Class, Props)
    local Inst = Instance.new(Class)
    for Key, Value in pairs(Props or {}) do
        if (Key == "Size" or Key == "Position") then
            Value = ApplyDPIScale(Value)
        elseif Key == "TextSize" then
            Value = ApplyTextScale(Value)
        end
        pcall(function() Inst[Key] = Value end)
    end
    return Inst
end

local function AddCorner(Inst, Radius)
    return Create("UICorner", {CornerRadius = UDim.new(0, (Radius or 5) * getgenv().DPIScale), Parent = Inst})
end

local function AddStroke(Inst, Color, Thickness, Transparency)
    return Create("UIStroke", {
        Color = Color or getgenv().Colors.Outline,
        Thickness = (Thickness or 1) * getgenv().DPIScale,
        Transparency = Transparency or 0.3,
        Parent = Inst,
    })
end

local function GetTextBounds(Text, Size)
    return TextService:GetTextSize(Text, Size * getgenv().DPIScale, Enum.Font.GothamMedium, Vector2.new(1920, 1080))
end

local function AddToRegistry(Instance, Properties)
    local Data = {Instance = Instance, Properties = Properties}
    table.insert(getgenv().UI.Registry, Data)
    getgenv().UI.RegistryMap[Instance] = Data
end

local function RemoveFromRegistry(Instance)
    local Data = getgenv().UI.RegistryMap[Instance]
    if Data then
        for Idx = #getgenv().UI.Registry, 1, -1 do
            if getgenv().UI.Registry[Idx] == Data then
                table.remove(getgenv().UI.Registry, Idx)
            end
        end
        getgenv().UI.RegistryMap[Instance] = nil
    end
end

function getgenv().UpdateColors()
    for _, Object in pairs(getgenv().UI.Registry) do
        for Property, ColorKey in pairs(Object.Properties) do
            if typeof(ColorKey) == "string" then
                Object.Instance[Property] = getgenv().Colors[ColorKey]
            end
        end
    end
end

function getgenv().AddSignal(Signal)
    table.insert(getgenv().UI.Signals, Signal)
end

function getgenv():Unload()
    for Idx = #getgenv().UI.Signals, 1, -1 do
        local Connection = table.remove(getgenv().UI.Signals, Idx)
        Connection:Disconnect()
    end
    for _, UnloadCallback in pairs(getgenv().UI.UnloadSignals) do
        pcall(UnloadCallback)
    end
    if getgenv().ScreenGui then
        getgenv().ScreenGui:Destroy()
    end
    getgenv().UI = nil
end

function getgenv():OnUnload(Callback)
    table.insert(getgenv().UI.UnloadSignals, Callback)
end


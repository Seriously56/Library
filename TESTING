function getgenv():MakeResizable(Instance)
    local ResizeBtn = Create("Frame", {
        BackgroundColor3 = getgenv().Colors.Accent,
        BackgroundTransparency = 0.8,
        Position = UDim2.new(1, -15, 1, -15),
        Size = UDim2.new(0, 15, 0, 15),
        Parent = Instance,
        ZIndex = 50,
    })
    AddCorner(ResizeBtn, 3)
    
    local Dragging = false
    local StartPos, StartSize
    
    ResizeBtn.InputBegan:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 then
            Dragging = true
            StartPos = Input.Position
            StartSize = Instance.Size
        end
    end)
    
    ResizeBtn.InputChanged:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseMovement and Dragging then
            local Delta = Input.Position - StartPos
            local NewSize = UDim2.new(
                StartSize.X.Scale,
                math.max(400, StartSize.X.Offset + Delta.X),
                StartSize.Y.Scale,
                math.max(350, StartSize.Y.Offset + Delta.Y)
            )
            Instance.Size = NewSize
        end
    end)
    
    UserInputService.InputEnded:Connect(function(Input)
        if Input.UserInputType == Enum.UserInputType.MouseButton1 then
            Dragging = false
        end
    end)
end

        AddStroke(Btn, getgenv().Colors.Outline, 0.5)
        AddToRegistry(Btn, {BackgroundColor3 = "Main", TextColor3 = "Accent"})
        
        local Picking = false
        
        function Picker:SetValue(Key)
            Picker.Value = Key
            Btn.Text = Key
            if Callback then pcall(Callback, Key) end
        end
        
        Btn.MouseButton1Click:Connect(function()
            if Picking then return end
            Picking = true
            Btn.Text = "..."
            
            local Event
            Event = UserInputService.InputBegan:Connect(function(Input)
                local Key
                if Input.UserInputType == Enum.UserInputType.Keyboard then
                    Key = Input.KeyCode.Name
                elseif Input.UserInputType == Enum.UserInputType.MouseButton1 then
                    Key = "MB1"
                elseif Input.UserInputType == Enum.UserInputType.MouseButton2 then
                    Key = "MB2"
                end
                if Key then
                    Picking = false
                    Btn.Text = Key
                    Picker.Value = Key
                    if Callback then pcall(Callback, Key) end
                    Event:Disconnect()
                end
            end)
            
            task.wait(5)
            if Picking then
                Picking = false
                Btn.Text = Picker.Value
            end
        end)
        
        Groupbox:Resize()
        getgenv().UI.Options[Text] = Picker
        return Picker
    end
    
    function Groupbox:AddSlider(Text, Min, Max, Default, Rounding, Callback)
        local Slider = { Value = Default }
        local Frame = Create("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 44),
            Parent = Content,
        })
        
        local Label = Create("TextLabel", {
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamMedium,
            Size = UDim2.new(1, 0, 0, 18),
            Text = Text .. ": " .. Default,
            TextColor3 = getgenv().Colors.Font,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = Frame,
        })
        AddToRegistry(Label, {TextColor3 = "Font"})
        
        local Track = Create("Frame", {
            BackgroundColor3 = getgenv().Colors.Main,
            Position = UDim2.new(0, 0, 0, 22),
            Size = UDim2.new(1, 0, 0, 6),
            Parent = Frame,
        })
        AddCorner(Track, 3)
        AddToRegistry(Track, {BackgroundColor3 = "Main"})
        
        local Fill = Create("Frame", {
            BackgroundColor3 = getgenv().Colors.Accent,
            Size = UDim2.new(((Default - Min) / (Max - Min)), 0, 1, 0),
            Parent = Track,
        })
        AddCorner(Fill, 3)
        AddToRegistry(Fill, {BackgroundColor3 = "Accent"})
        
        local Knob = Create("TextButton", {
            BackgroundColor3 = getgenv().Colors.Accent,
            Position = UDim2.new(((Default - Min) / (Max - Min)), -9, 0, -5),
            Size = UDim2.new(0, 18, 0, 18),
            Text = "",
            Parent = Track,
        })
        AddCorner(Knob, 9)
        AddStroke(Knob, getgenv().Colors.AccentDark, 0.5)
        AddToRegistry(Knob, {BackgroundColor3 = "Accent"})
        
        local Dragging = false
        
        function Slider:SetValue(Value)
            Slider.Value = Value
            local Percent = (Value - Min) / (Max - Min)
            Fill.Size = UDim2.new(Percent, 0, 1, 0)
            Knob.Position = UDim2.new(Percent, -9, 0, -5)
            Label.Text = Text .. ": " .. Value
            if Callback then pcall(Callback, Value) end
        end
        
        Knob.MouseButton1Down:Connect(function()
            Dragging = true
        end)
        
        UserInputService.InputEnded:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1 then
                Dragging = false
            end
        end)
        
        Track.InputBegan:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1 then
                local X = Input.Position.X - Track.AbsolutePosition.X
                local Percent = math.clamp(X / Track.AbsoluteSize.X, 0, 1)
                local Value = Min + Percent * (Max - Min)
                if Rounding then
                    Value = math.round(Value / Rounding) * Rounding
                end
                Slider:SetValue(Value)
            end
        end)
        
        RunService.RenderStepped:Connect(function()
            if Dragging then
                local X = Mouse.X - Track.AbsolutePosition.X
                local Percent = math.clamp(X / Track.AbsoluteSize.X, 0, 1)
                local Value = Min + Percent * (Max - Min)
                if Rounding then
                    Value = math.round(Value / Rounding) * Rounding
                end
                Slider:SetValue(Value)
            end
        end)
        
        Groupbox:Resize()
        getgenv().UI.Options[Text] = Slider
        return Slider
    end
    
    function Groupbox:AddDropdown(Text, Values, Default, Callback)
        local Dropdown = { Value = Default or Values[1] }
        local Frame = Create("Frame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 0, 44),
            Parent = Content,
        })
        
        local Label = Create("TextLabel", {
            BackgroundTransparency = 1,
            Font = Enum.Font.GothamMedium,
            Size = UDim2.new(1, 0, 0, 18),
            Text = Text,
            TextColor3 = getgenv().Colors.Font,
            TextSize = 12,
            TextXAlignment = Enum.TextXAlignment.Left,
            Parent = Frame,
        })
        AddToRegistry(Label, {TextColor3 = "Font"})
        
        local Btn = Create("TextButton", {
            BackgroundColor3 = getgenv().Colors.Main,
            Position = UDim2.new(0, 0, 0, 20),
            Size = UDim2.new(1, 0, 0, 22),
            Text = Dropdown.Value,
            TextColor3 = getgenv().Colors.Font,
            TextSize = 12,
            Font = Enum.Font.GothamMedium,
            Parent = Frame,
        })
        AddCorner(Btn, 4)
        AddStroke(Btn, getgenv().Colors.Outline, 0.5)
        AddToRegistry(Btn, {BackgroundColor3 = "Main", TextColor3 = "Font"})
        
        local List = Create("Frame", {
            BackgroundColor3 = getgenv().Colors.Main,
            Position = UDim2.new(0, 0, 0, 42),
            Size = UDim2.new(1, 0, 0, 0),
            Visible = false,
            Parent = Frame,
            ClipsDescendants = true,
        })
        AddCorner(List, 4)
        AddStroke(List, getgenv().Colors.Outline, 0.5)
        AddToRegistry(List, {BackgroundColor3 = "Main"})
        
        local ListContainer = Create("ScrollingFrame", {
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            ScrollBarThickness = 2,
            ScrollBarImageColor3 = getgenv().Colors.Accent,
            Parent = List,
        })
        
        local ListLayout = Create("UIListLayout", {
            FillDirection = Enum.FillDirection.Vertical,
            Parent = ListContainer,
        })
        
        local function UpdateList()
            for _, Child in pairs(ListContainer:GetChildren()) do
                if Child:IsA("TextButton") then Child:Destroy() end
            end
            local Height = 0
            for _, Value in ipairs(Values) do
                local Option = Create("TextButton", {
                    BackgroundColor3 = getgenv().Colors.Main,
                    Size = UDim2.new(1, 0, 0, 22),
                    Text = Value,
                    TextColor3 = getgenv().Colors.Font,
                    TextSize = 12,
                    Font = Enum.Font.GothamMedium,
                    Parent = ListContainer,
                })
                AddToRegistry(Option, {BackgroundColor3 = "Main", TextColor3 = "Font"})
                Option.MouseEnter:Connect(function()
                    Option.BackgroundColor3 = getgenv().Colors.Outline
                    AddToRegistry(Option, {BackgroundColor3 = "Outline"})
                end)
                Option.MouseLeave:Connect(function()
                    Option.BackgroundColor3 = getgenv().Colors.Main
                    AddToRegistry(Option, {BackgroundColor3 = "Main"})
                end)
                Option.MouseButton1Click:Connect(function()
                    Dropdown.Value = Value
                    Btn.Text = Value
                    List.Visible = false
                    if Callback then pcall(Callback, Value) end
                end)
                Height = Height + 22
            end
            ListContainer.CanvasSize = UDim2.new(0, 0, 0, Height)
            local MaxHeight = math.min(Height, 150)
            List.Size = UDim2.new(1, 0, 0, MaxHeight)
        end
        UpdateList()
        
        Btn.MouseButton1Click:Connect(function()
            List.Visible = not List.Visible
            if List.Visible then
                List.Size = UDim2.new(1, 0, 0, 0)
                ListContainer.CanvasSize = UDim2.new(0, 0, 0, 0)
                task.wait()
                local Height = 0
                for _, Child in pairs(ListContainer:GetChildren()) do
                    if Child:IsA("TextButton") then
                        Height = Height + 22
                    end
                end
                local MaxHeight = math.min(Height, 150)
                List.Size = UDim2.new(1, 0, 0, MaxHeight)
                ListContainer.CanvasSize = UDim2.new(0, 0, 0, Height)
            end
        end)
        
        -- Close dropdown when clicking outside
        UserInputService.InputBegan:Connect(function(Input)
            if Input.UserInputType == Enum.UserInputType.MouseButton1 then
                local AbsPos, AbsSize = List.AbsolutePosition, List.AbsoluteSize
                if Mouse.X < AbsPos.X or Mouse.X > AbsPos.X + AbsSize.X
                    or Mouse.Y < AbsPos.Y or Mouse.Y > AbsPos.Y + AbsSize.Y then
                    List.Visible = false
                end
            end
        end)
        
        Groupbox:Resize()
        getgenv().UI.Options[Text] = Dropdown
        return Dropdown
    end
    

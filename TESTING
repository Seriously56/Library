        BackgroundColor3 = getgenv().Colors.Background,
        BorderSizePixel = 0,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        Position = UDim2.new(0, 6, 0, 78),
        Size = UDim2.new(1, -12, 1, -90),
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = getgenv().Colors.Accent,
        Visible = false,
        Parent = getgenv().WindowInner,
    })
    
    local TabLayout2 = Create("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = TabFrame,
    })
    
    Tab.Container = TabFrame
    Tab.Button = Button
    Tab.Layout = TabLayout2
    getgenv().TabFrames[Name] = TabFrame
    
    Button.MouseButton1Click:Connect(function()
        for _, OtherButton in pairs(TabContainer:GetChildren()) do
            if OtherButton:IsA("TextButton") then
                OtherButton.BackgroundColor3 = getgenv().Colors.Main
                OtherButton.TextColor3 = getgenv().Colors.Muted
                AddStroke(OtherButton, getgenv().Colors.Outline, 0.5)
            end
        end
        for _, Frame in pairs(getgenv().TabFrames) do
            Frame.Visible = false
        end
        Button.BackgroundColor3 = getgenv().Colors.Accent
        Button.TextColor3 = getgenv().Colors.Font
        AddStroke(Button, getgenv().Colors.AccentDark, 0.5)
        TabFrame.Visible = true
        getgenv().CurrentTab = Name
    end)
    
    -- Show first tab by default
    if not getgenv().CurrentTab then
        Button.BackgroundColor3 = getgenv().Colors.Accent
        Button.TextColor3 = getgenv().Colors.Font
        AddStroke(Button, getgenv().Colors.AccentDark, 0.5)
        TabFrame.Visible = true
        getgenv().CurrentTab = Name
    end
    
    return Tab
end

